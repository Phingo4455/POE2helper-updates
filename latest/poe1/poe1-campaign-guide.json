    "POE1 路线的地图、NPC、Boss 和任务物品统一显示为中文（英文）。"
  ],
  "routes": [
    {
      "id": "act1",
      "label": "第一幕",
      "tasks": [
        [
          "required",
          "暮光海滩 → 狮眼守望",
          "击败 Hillock，进入 Lioneye’s Watch；领取主技能并检查武器。"
        ],
        [
          "required",
          "海潮孤岛 → 炙热盐沼",
          "从 Tidal Island 取得 Medicine Chest，回城领取水银药剂；穿过 Mud Flats 打开水下通道。"
        ],
        [
          "required",
          "水下通道 → 禁灵之狱",
          "在 Submerged Passage 开传送点；前往 Flooded Depths 击败 Dweller of the Deep 获得天赋点，再进入监狱。"
        ],
        [
          "trial",
          "禁灵之狱：升华试炼",
          "完成 Lower Prison 的首个迷宫试炼，击败 Brutus。"
        ],
        [
          "required",
          "船墓 → 愤怒洞窟",
          "在 Ship Graveyard 找 Allflame，击败 Fairgraves 获得天赋点；进入 Cavern of Wrath。"
        ],
        [
          "required",
          "怨忿洞窟：幕终 Boss",
          "击败 Merveil，进入第二幕森林营地。"
        ]
      ]
    },
    {
      "id": "act2",
      "label": "第二幕",
      "tasks": [
        [
          "required",
          "南部森林 → 森林营地",
          "沿道路进入营地，优先处理盗贼任务路线。"
        ],
        [
          "reward",
          "兽穴 → 湿地",
          "击败 Great White Beast；在 Wetlands 击败 Oak 或按流派帮助盗贼，开启 Vaal Ruins。"
        ],
        [
          "required",
          "罪孽之殿",
          "在 Chamber of Sins 第二层完成试炼并取得 Baleful Gem。"
        ],
        [
          "reward",
          "西部密林",
          "处理 Alira；击败 Weaver 取得 Spike，打开 Western Forest 封路并完成 Captain Arteri 天赋点。"
        ],
        [
          "required",
          "北部密林 → 古金字塔",
          "处理 Kraityn，取得三枚护符；穿过 Vaal Ruins 和 Northern Forest。"
        ],
        [
          "required",
          "古金字塔：幕终 Boss",
          "击败 Vaal Oversoul，进入第三幕。"
        ]
      ]
    },
    {
      "id": "act3",
      "label": "第三幕",
      "tasks": [
        [
          "required",
          "贫民窟 → 火葬场",
          "救出 Clarissa；在 Crematorium 完成试炼并击败 Piety，取得 Tolman’s Bracelet。"
        ],
        [
          "required",
          "下水道 → 市集",
          "取得 Sewer Keys，收集三座 Platinum Bust；从 Marketplace 前往 Battlefront。"
        ],
        [
          "required",
          "战场 → 码头",
          "取得 Ribbon Spool 与 Thaumetic Sulphite，进入 Solaris Temple。"
        ],
        [
          "required",
          "月影神殿",
          "穿过 Ebony Barracks，击败 General Gravicius；在 Lunaris Temple 击败 Piety。"
        ],
        [
          "trial",
          "帝国花园",
          "完成 Imperial Gardens 试炼，进入 Library 可选解锁宝石商店。"
        ],
        [
          "required",
          "神权之塔：幕终 Boss",
          "使用 Tower Key 进入 Sceptre of God，击败 Dominus。"
        ]
      ]
    },
    {
      "id": "act4",
      "label": "第四幕",
      "tasks": [
        [
          "required",
          "干涸湖岸 → 水晶矿脉",
          "击败 Voll 取得 Deshret’s Banner，穿过 Mines 并释放 Deshret 灵魂获得天赋点。"
        ],
        [
          "required",
          "冈姆幻境",
          "穿过 Kaom’s Dream 与 Stronghold，击败 Kaom 取得 Eye of Fury。"
        ],
        [
          "required",
          "大竞技场",
          "穿过 Daresso’s Dream，击败 Daresso 取得 Eye of Desire。"
        ],
        [
          "required",
          "巨兽腹部",
          "返回 Crystal Veins，进入 Belly of the Beast，击败 Piety。"
        ],
        [
          "required",
          "育灵之室：幕终",
          "依次击败 Maligaro、Shavronne、Doedre，再击败 Malachai。"
        ]
      ]
    },
    {
      "id": "act5",
      "label": "第五幕",
      "tasks": [
        [
          "required",
          "奴役监牢 → 监工之塔",
          "击败 Overseer Krow，进入 Overseer’s Tower。"
        ],
        [
          "reward",
          "控制区",
          "取得 Miasmeter；击败 Justicar Casticus 并救出 Vilenta。"
        ],
        [
          "required",
          "奥瑞亚广场 → 圣堂屋顶",
          "穿过 Templar Courts，击败 Avarius。"
        ],
        [
          "reward",
          "藏骨堂",
          "在 Ossuary 取得 Sign of Purity；完成 Kitava’s Torments 获得天赋点。"
        ],
        [
          "required",
          "圣堂屋顶：幕终 Boss",
          "击败 Kitava；承受第一次抗性惩罚后进入第六幕。"
        ]
      ]
    },
    {
      "id": "act6",
      "label": "第六幕",
      "tasks": [
        [
          "required",
          "暮光海滩清理",
          "完成 Lilly Roth 的海滩清理，解锁宝石商店。"
        ],
        [
          "required",
          "海岸 → 泥滩",
          "击败 Dishonoured Queen，取得 Eye of Conquest；击败 Tukohama 获得天赋点。"
        ],
        [
          "trial",
          "禁灵之狱",
          "完成 Prison 试炼，击败 Shavronne 与 Brutus。"
        ],
        [
          "reward",
          "河道 → 湿地",
          "击败 Abberath 与 Ryslatha，分别获得天赋点。"
        ],
        [
          "required",
          "南部森林 → 灯塔",
          "点燃 Beacon，护送燃料车并乘船前往 Brine King’s Reef。"
        ],
        [
          "required",
          "海礁：幕终 Boss",
          "击败 Brine King，进入第七幕。"
        ]
      ]
    },
    {
      "id": "act7",
      "label": "第七幕",
      "tasks": [
        [
          "required",
          "断桥 → 十字路口",
          "取得 Silver Locket；从 Crossroads 进入 Fellshrine Ruins。"
        ],
        [
          "required",
          "罪孽之殿",
          "取得 Maligaro’s Map；完成第二层试炼并通过地图击败 Maligaro。"
        ],
        [
          "reward",
          "北部森林",
          "击败 Gruthkul 获得天赋点；在 Dread Thicket 收集萤火虫。"
        ],
        [
          "required",
          "堤道 → 瓦尔古城",
          "取得 Kishara’s Star；穿过 Causeway 进入 Vaal City。"
        ],
        [
          "required",
          "腐朽神殿：幕终 Boss",
          "击败 Arakaali，进入第八幕。"
        ]
      ]
    },
    {
      "id": "act8",
      "label": "第八幕",
      "tasks": [
        [
          "required",
          "有毒管道 → Doedre 污水池",
          "击败 Doedre，开启东西两侧路线。"
        ],
        [
          "reward",
          "码头 → 粮仓",
          "取得 Ankh of Eternity；击败 Tolman 与 Gemling Legion 获得天赋点。"
        ],
        [
          "trial",
          "浴场",
          "完成 Bath House 试炼；击败 Yugul 获得天赋点。"
        ],
        [
          "required",
          "月影广场 → 日耀神殿",
          "分别取得 Moon Orb 与 Sun Orb。"
        ],
        [
          "required",
          "港口大桥：幕终 Boss",
          "击败 Solaris 与 Lunaris，进入第九幕。"
        ]
      ]
    },
    {
      "id": "act9",
      "label": "第九幕",
      "tasks": [
        [
          "required",
          "鲜血水道 → 瓦斯提里沙漠",
          "进入 Highgate，寻找 Storm Blade 并交给 Petarus 与 Vanja。"
        ],
        [
          "reward",
          "绿洲 → 沸水湖",
          "击败 Shakari 与 Basilisk，取得 Acid；完成支线天赋点。"
        ],
        [
          "required",
          "隧道 → 采石场",
          "完成 Tunnel 试炼；在 Quarry 开启 Shrine of the Winds 与 Refinery。"
        ],
        [
          "reward",
          "风之圣殿",
          "击败 Garukhan，解救 Sekhema Oyun 获得天赋点。"
        ],
        [
          "required",
          "炼油厂 → 巨兽腹部",
          "取得 Trarthan Powder，制作混合物进入 Belly of the Beast。"
        ],
        [
          "required",
          "腐化核心：幕终 Boss",
          "击败三名守卫和 Depraved Trinity，进入第十幕。"
        ]
      ]
    },
    {
      "id": "act10",
      "label": "第十幕",
      "tasks": [
        [
          "required",
          "大教堂屋顶",
          "救出 Bannon，进入 Ravaged Square。"
        ],
        [
          "reward",
          "控制区 → 藏骨堂",
          "击败 Vilenta 获得天赋点；在 Ossuary 取得 Elixir of Allure。"
        ],
        [
          "trial",
          "藏骨堂试炼",
          "完成最后一个剧情迷宫试炼，准备终极迷宫。"
        ],
        [
          "required",
          "焚化场 → 饮水口",
          "取得 Innocence Staff；击败 Avarius Reassembled。"
        ],
        [
          "required",
          "运河 → 饲槽",
          "确认抗性和装备后进入最终区域。"
        ],
        [
          "required",
          "饲槽：最终 Boss",
          "击败 Kitava，承受最终抗性惩罚；前往 Oriath 并进入异界。"
        ]
      ]
    }
  ],
